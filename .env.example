# Nunca commitear claves reales. Copia este archivo a .env y completa solo lo que necesites.

# ── Claves (sin valores aquí) ────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
# Si OPENROUTER_API_KEY está definida, Gemini se llama vía OpenRouter en vez de Google AI Studio.
OPENROUTER_API_KEY=
# Catálogo de laboratorio (Supabase). El flujo de análisis solo LEE; las escrituras requieren scripts con --apply explícito.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Modelos (configurables sin tocar código) ─────────────────────────────────
GEMINI_READER_MODEL=gemini-4-argon
OPENAI_READER_MODEL=gpt-6.1-sol
OPENAI_JUDGE_MODEL=gpt-6-astra
OPENROUTER_GEMINI_MODEL=google/gemini-3.8-flash
# Resolvedor de catálogo y señal de documento (GPT sobre el catálogo completo)
OPENAI_CATALOG_MODEL=gpt-6.1-sol

# ── Razonamiento (ajustar después del benchmark, no por intuición) ───────────
GEMINI_THINKING_LEVEL=medium
OPENROUTER_GEMINI_REASONING=medium
# (Opcional) Tope de tokens de salida de Gemini en OpenRouter (razonamiento + JSON; 1024-65536, por defecto 8192).
# OPENROUTER_GEMINI_MAX_TOKENS=8192
# (Opcional) Si la respuesta se trunca hay UN reintento: tope 1,5 veces mayor (12288 por defecto) y razonamiento "low" por defecto.
# OPENROUTER_GEMINI_RETRY_MAX_TOKENS=12288
# OPENROUTER_GEMINI_RETRY_REASONING=low
OPENAI_READER_REASONING=high
OPENAI_JUDGE_REASONING=high
OPENAI_CATALOG_REASONING=medium
OPENAI_DOCUMENT_REASONING=medium

# ── Banderas semánticas: APAGADAS por defecto ────────────────────────────────
# Solo el valor exacto "on" las enciende; cualquier otro valor o su ausencia las deja apagadas.
# PRIMARY: GPT resuelve TODOS los estudios contra el catálogo completo (con contraste frente al matcher exacto).
CATALOG_SEMANTIC_PRIMARY=off
# AUTO: los MATCH semánticos verificados pueden entrar a una cotización AUTO_SAFE. Solo tiene efecto con PRIMARY=on.
# No activar para usuarios reales sin autorización expresa.
CATALOG_SEMANTIC_AUTO=off
# HANDWRITTEN: off = un pedido manuscrito siempre va a revisión (handwritten_out_of_scope).
#   shadow = además evalúa y reporta (`handwrittenShadow`, requiere PRIMARY=on) si sería AUTO bajo criterios estrictos; NUNCA cambia la decisión real.
#   on = el manuscrito deja de bloquearse por serlo y se rige por los MISMOS requisitos que un impreso (lectura confiable, consenso, variantes
#        claras, matching verificado y precios del catálogo). No activar sin validar el comportamiento.
CATALOG_HANDWRITTEN_AUTO=off
# PARTIAL: cada estudio se decide por separado. Los estudios seguros se cotizan automáticamente aunque otros requieran revisión. El paciente recibe
# SOLO `publicQuote` (estudios, precios y "Total de los estudios cotizados"); los pendientes, bloqueos y zonas que no se ven quedan SOLO en el
# registro interno `internal` (CRM). Si ningún estudio se verifica no hay cotización automática. Solo el valor exacto "on" la enciende.
CATALOG_PARTIAL_AUTO=off

# ── Cache local de respuestas de IA (siempre que sea posible, reutilizarlo) ──
# on (por defecto) | off (nunca lee ni escribe cache) | refresh (ignora lo guardado y lo reescribe)
AI_CACHE=on
# AI_CACHE_DIR=.cache

# ── Control de gastos de las pruebas con modelos reales ──────────────────────
# Tarifas (US$ por millón de tokens) con las que scripts/spend.ts estima el costo de OpenAI.
OPENAI_CATALOG_PRICE_INPUT_PER_MTOK=2
OPENAI_CATALOG_PRICE_OUTPUT_PER_MTOK=10
# Los scripts de validación (shadow-match, benchmark-catalog, semantic-primary-check, semantic-auto-check, context-check) BLOQUEAN toda
# llamada real si no se autoriza un máximo en USD por corrida. NO lo dejes definido de forma permanente: pásalo en el comando.
# PLUSMEDIK_AUTHORIZE_PAID_CALLS=0.15
# Referencia independiente usada solo por scripts/semantic-auto-check.ts
# OPENAI_REFERENCE_MODEL=gpt-6.1-sol
# OPENAI_REFERENCE_REASONING=high

# ── WhatsApp (Kapso) en Vercel: POST /api/kapso/webhook ──────────────────────
# Secreto con el que Kapso firma el webhook (HMAC-SHA256 del cuerpo, encabezado x-webhook-signature). Sin él todo se rechaza con 401.
WEBHOOK_SECRET=
# KAPSO_API_KEY y KAPSO_PHONE_NUMBER_ID (arriba de este bloque en tu .env): envío de mensajes y descarga de medios.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# (Opcional) Piloto: solo estos números reciben respuesta (dígitos, separados por coma). Sin definir, responde a cualquiera.
ALLOWED_PHONES=
# El motor necesita además OPENAI_API_KEY, OPENROUTER_API_KEY, OPENROUTER_GEMINI_MODEL, SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY (ya definidas arriba).
# En Vercel NO definas las banderas CATALOG_*: el webhook pasa por código las ya validadas (semántico, AUTO parcial, manuscrito).

# ── Atención humana (apagado automático de la IA; APAGADO por defecto; ver README) ──
# on = una persona escribiendo desde WhatsApp Business pausa la IA para ese contacto. Con él activo, sin la clave dedicada NO se responde a nadie.
PLUSMEDIK_HUMAN_CONTROL=
# Clave DEDICADA (>= 32 caracteres) para el HMAC de la clave de contacto. No reutilices WEBHOOK_SECRET ni ninguna otra clave. No se versiona.
PLUSMEDIK_CONTACT_HMAC_KEY=
# on = el claim de la auditoría es obligatorio para responder (requisito de producción recomendado; el control de atención humana ya lo implica).
REQUIRE_AUDIT_GUARD=

# ── Turnos conversacionales (G2.0; APAGADO por defecto; ver docs/g2) ──
# on = coordina varios mensajes consecutivos de un mismo contacto: numeración por contacto, un solo envío en vuelo por contacto y descarte de respuestas obsoletas.
# Exige las migraciones 01-07 aplicadas y PLUSMEDIK_CONTACT_HMAC_KEY (sin ella no se responde a nadie). Implica el claim obligatorio (como REQUIRE_AUDIT_GUARD).
# Sin PLUSMEDIK_TEXT_HANDLER, encendido solo coordina las imágenes; el texto y otros mensajes siguen ignorándose. NO activar en producción.
PLUSMEDIK_TURNS=
# on = (solo con PLUSMEDIK_TURNS=on) responde a los mensajes de TEXTO con textos fijos BORRADOR (src/text-handler.ts): saludo, pedir la foto de la receta y avisos de que
# no se puede orientar. Sin horarios, precios, políticas ni datos médicos. NO confirma nunca una derivación a una persona (bloqueada hasta que el CRM reciba casos).
# Los textos deben ser aprobados por el laboratorio ANTES de activarlo. NO activar en producción.
PLUSMEDIK_TEXT_HANDLER=
# on = (solo con PLUSMEDIK_TURNS=on y PLUSMEDIK_TEXT_HANDLER=on) responde horarios, sucursales, políticas, pagos, preguntas frecuentes y preparación de estudios SOLO con conocimiento
# APROBADO y vigente del laboratorio (src/knowledge-answers.ts). Sin datos aprobados responde como sin conocimiento. Exige las 9 migraciones y datos cargados y aprobados. NO activar en producción.
PLUSMEDIK_KNOWLEDGE_ANSWERS=
# on = (solo con PLUSMEDIK_TURNS=on y PLUSMEDIK_TEXT_HANDLER=on) protección contra bucles y exceso de respuestas (G3.2): tope de respuestas por contacto y ventana, ráfagas, respuestas repetidas y
# mensajes automáticos (src/reply-guard.ts). Exige la 10ª migración (sin ella el texto no se responde). Encender ANTES que PLUSMEDIK_TEXT_HANDLER. NO activar en producción sin la migración.
PLUSMEDIK_REPLY_GUARD=
# JSON opcional con los umbrales, p. ej. {"rules":[{"windowSeconds":600,"max":8}],"burst":{"windowSeconds":60,"max":8},"repeat":{"windowSeconds":900,"max":3},"cooldownSeconds":900}. En blanco = valores iniciales.
PLUSMEDIK_REPLY_GUARD_CONFIG=
# on = (solo con PLUSMEDIK_TURNS=on y PLUSMEDIK_TEXT_HANDLER=on) sesiones de cotización (G4.0): varias fotos y estudios escritos se juntan y se cotizan cuando el paciente escribe LISTO,
# con estudios y precios vigentes de lab_tests; los casos inciertos no se cotizan. Exige la 11ª migración (sin ella las fotos responden con el aviso técnico). NO activar en producción.
PLUSMEDIK_QUOTE_SESSIONS=
# Motor global de lotes (APAGADO por defecto; ver docs/g6/03-conexion-del-motor-de-lotes.md). Solo actúa en un lote de Kapso (varios mensajes de un contacto) y exige las sesiones de cotización.
#   shadow = la ruta de siempre responde y escribe como hoy; el motor nuevo solo DECIDE en paralelo y deja la línea de registro "batch_shadow" (solo códigos) para comparar. ESTRICTAMENTE de solo lectura (no envía ni escribe nada propio).
#            Exige la 20ª migración (plusmedik_quote_shadow_peek, función de solo lectura); sin ella no compara nada.
#   on     = el motor nuevo atiende el texto del lote (decide UNA vez, cotiza directo con intención clara y estudios resueltos); la ruta de siempre queda de respaldo si falla antes de tocar nada.
# En blanco u off = apagado. Cualquier otro valor deja el motor apagado y registra "batch_engine_config_invalid".
PLUSMEDIK_BATCH_ENGINE=
# on = en el telefono piloto, CADA foto se cotiza inmediatamente con precios y preparaciones aprobadas (sin esperar LISTO).
# Solo tiene efecto con PLUSMEDIK_QUOTE_SESSIONS=on, PLUSMEDIK_TEXT_PILOT_GUARD=on y puerta valida.
# Los estudios escritos siguen usando sesiones; los demas pacientes siguen con las fotos anteriores.
PLUSMEDIK_INSTANT_PHOTO_QUOTES=
# on = añade EN EL MISMO MENSAJE de cotización las preparaciones APROBADAS y vigentes de los estudios cotizados (máx. 5);
# no usa ChatGPT, no combina indicaciones distintas y no altera precios ni matching.
# Exige PLUSMEDIK_TURNS, PLUSMEDIK_TEXT_HANDLER, PLUSMEDIK_KNOWLEDGE_ANSWERS y PLUSMEDIK_REPLY_GUARD en on, más rastro clínico auditable.
# Si no hay preparaciones aprobadas, no se añade nada; los 470 borradores actuales quedan excluidos.
PLUSMEDIK_QUOTE_PREPARATIONS=
# on = (solo con PLUSMEDIK_TURNS, PLUSMEDIK_TEXT_HANDLER y PLUSMEDIK_KNOWLEDGE_ANSWERS en on) datos aprobados por estudio (G4.1): plazo de entrega en horas o días, tipo de muestra y
# requisitos, también sobre los estudios de la última cotización. Exige la 12ª migración y datos APROBADOS; sin ellos responde que no tiene el dato. NO activar en producción.
PLUSMEDIK_STUDY_INFO=
# on = (solo con PLUSMEDIK_TURNS=on y PLUSMEDIK_TEXT_HANDLER=on) derivación segura de casos al CRM (G5.0): cola de salida persistente e idempotente hacia POST /api/internal/agent/review-case del CRM.
# Exige la 13ª migración y TODA esta configuración; si falta algo la derivación sigue BLOQUEADA. Al paciente solo se le confirma cuando el CRM ya registró el caso. NO activar en producción.
PLUSMEDIK_CRM_HANDOFF=
# Base HTTPS del CRM (sin la ruta), p. ej. https://crm.ejemplo.com
PLUSMEDIK_CRM_REVIEW_URL=
# Token exclusivo agente->CRM (>= 32 caracteres); debe ser el mismo PLUSMEDIK_AGENT_REVIEW_INGEST_TOKEN del CRM. Nunca se registra.
PLUSMEDIK_CRM_REVIEW_TOKEN=
# Secreto (>= 32 caracteres) para cifrar en reposo el cuerpo de los eventos (lleva el teléfono). Distinto de la clave HMAC de contactos.
PLUSMEDIK_OUTBOX_KEY=
# on = (solo con PLUSMEDIK_TURNS=on, PLUSMEDIK_TEXT_HANDLER=on y PLUSMEDIK_REPLY_GUARD=on) conversación natural con OpenAI (G5.3). El modelo SOLO conversa y clasifica el mensaje con el prompt de
# src/system-prompt.ts (SYSTEM_PROMPT, importado como código: sin archivos ni variables de entorno para el prompt): precios, preparación, resultados y datos del laboratorio siguen saliendo solo del catálogo y del conocimiento aprobado; lo médico, pedir a una persona y la
# información NUNCA dependen de él; una salida con cifras, enlaces, datos del laboratorio o promesas se descarta y se responde con el texto fijo. Exige OPENAI_API_KEY y OPENAI_CONVERSATION_MODEL.
# Envía a OpenAI el texto del paciente (recortado y sin enlaces, correos ni números largos; con store=false): requiere aprobación de privacidad del laboratorio. NO activar en producción.
PLUSMEDIK_LLM_CONVERSATION=
# on = (solo con PLUSMEDIK_LLM_CONVERSATION=on) además de conversar, el modelo recibe los datos comerciales CONFIRMADOS y vigentes de src/system-prompt.ts (BUSINESS_DATA: sucursales, direcciones, horarios,
# teléfonos, servicios, métodos de pago, políticas) y puede informarlos; cada cifra, horario, teléfono, enlace y día de su respuesta debe existir en esos datos o se descarta. Precios, estudios, preparación
# clínica y tiempos de entrega siguen saliendo SOLO de Supabase; cotizaciones y derivaciones al CRM, del backend. Sin ninguna sección confirmada y vigente se queda apagada. NO activar en producción.
PLUSMEDIK_LLM_BUSINESS_INFO=
# Modelo para la conversación. OBLIGATORIO si se activa; no hay valor por defecto (elegirlo es una decisión del dueño).
OPENAI_CONVERSATION_MODEL=
# Opcional: low | medium | high | xhigh | max (solo para modelos que admiten razonamiento). En blanco = no se envía.
OPENAI_CONVERSATION_REASONING=
# Opcional: qué mensajes pueden pasar por el modelo, separados por comas: GREETING, OTHER (por defecto) y/o RECIPE_OR_QUOTE.
PLUSMEDIK_LLM_CATEGORIES=
# Opcionales (en blanco = valores por defecto): tiempo máximo por llamada en ms (1000-30000; 8000), tokens máximos de salida (50-2000; 300) y caracteres máximos del mensaje enviado (50-2000; 500).
PLUSMEDIK_LLM_TIMEOUT_MS=
PLUSMEDIK_LLM_MAX_OUTPUT_TOKENS=
PLUSMEDIK_LLM_MAX_INPUT_CHARS=
# on = (solo con PLUSMEDIK_TURNS=on y PLUSMEDIK_TEXT_HANDLER=on) atención selectiva (G6.0): NO responde saludos aislados, cortesías, mensajes sin letras ni repeticiones literales (sin modelo y sin consultas), agrupa las
# confirmaciones de varios mensajes seguidos y, con la conversación con modelo, le da el ESTADO de la conversación (cantidades, no textos). Lo médico, pedir a una persona y cualquier posible solicitud se procesan siempre.
# No requiere migración. NO activar en producción.
PLUSMEDIK_ATTENTION_FILTER=
# Opcionales (en blanco = valores por defecto): segundos en que un mensaje idéntico se considera repetición (5-600; 90) y milisegundos que espera una confirmación de "anotado" por si llega otro mensaje (0-10000; 2000).
PLUSMEDIK_ATTENTION_REPEAT_SECONDS=
PLUSMEDIK_ATTENTION_SETTLE_MS=
# on = (Fase 1 de la integración con el CRM) habilita las rutas internas POST /api/internal/crm/attention/status y /action, con las que el CRM consulta el estado de atención y pausa o reactiva la IA de un contacto
# (idempotente por operationId; no simula mensajes de WhatsApp). Exige PLUSMEDIK_AGENT_CONTROL_TOKEN y KAPSO_PHONE_NUMBER_ID. Aunque esté encendida, si no hay ni PLUSMEDIK_HUMAN_CONTROL=on ni una lista en
# PLUSMEDIK_AGENT_CONTROL_PHONES (o la clave HMAC de contactos no es válida) no se muta nada: status responde available:false y action no confirma. Exige la 15ª migración. NO activar en producción sin autorización.
PLUSMEDIK_AGENT_CONTROL=
# Lista EXPLÍCITA de números autorizados para el control del CRM (separados por coma, solo dígitos con prefijo de país, máx. 10). Modo ACOTADO, pensado para probar con un contacto sin tocar a los demás:
# con ella y SIN PLUSMEDIK_HUMAN_CONTROL, solo esos números pueden consultarse, pausarse y reactivarse (cualquier otro recibe 403) y SOLO para ellos el webhook exige el claim con clave de contacto y respeta la pausa;
# los demás pacientes siguen el flujo de siempre. NO activa la pausa automática por mensajes humanos (eso es PLUSMEDIK_HUMAN_CONTROL) y NO sustituye a ALLOWED_PHONES. Con PLUSMEDIK_HUMAN_CONTROL=on solo restringe
# a quién puede operar el CRM. Una lista mal formada deja las rutas en 503. Exige PLUSMEDIK_CONTACT_HMAC_KEY. Antes de retirar un número de la lista, reactívalo (la pausa guardada deja de respetarse).
PLUSMEDIK_AGENT_CONTROL_PHONES=
# Token Bearer EXCLUSIVO CRM -> agente (>= 32 caracteres, aleatorio). El mismo valor va en PLUSMEDIK_AGENT_CONTROL_TOKEN del CRM. No es la service key, ni la clave HMAC, ni una credencial de Kapso.
PLUSMEDIK_AGENT_CONTROL_TOKEN=

# Diagnóstico visual por huellas HMAC: apagado por defecto. No cambia cotización, matching ni mensajes.
# Solo habilitar temporalmente en un entorno de prueba, con un máximo de 10 números autorizados.
# Ningún texto clínico ni imagen se registra. No reutilizar secretos de CRM/Kapso/Supabase.
PLUSMEDIK_VISION_DIAGNOSTICS=
# Clave aleatoria exclusiva de diagnóstico (mínimo 32 caracteres); NO subir el valor al repo.
PLUSMEDIK_VISION_DIAGNOSTICS_KEY=
# Números del equipo, solo dígitos y código de país, separados por coma. En blanco = no se activa.
PLUSMEDIK_VISION_DIAGNOSTICS_PHONES=

# on = puerta ESTRICTA para turnos/texto, sin cambiar la autorización del CRM.
# PLUSMEDIK_AGENT_CONTROL_PHONES sigue exigiendo UN SOLO número piloto original.
# PLUSMEDIK_TEXT_PILOT_EXTRA_PHONES admite HASTA DOS números adicionales,
# separados por coma, completos y distintos del piloto original.
# ALLOWED_PHONES conserva su significado anterior: si no está vacía debe incluir
# al piloto original y a todos los adicionales; no reducirla a un solo teléfono.
# El resto de contactos conserva únicamente la ruta anterior de imágenes.
# Si una lista es inválida, turnos/texto fallan cerrado y las imágenes se conservan.
# Sin extras definidos la funcionalidad permanece idéntica al piloto anterior.
PLUSMEDIK_TEXT_PILOT_GUARD=
PLUSMEDIK_TEXT_PILOT_EXTRA_PHONES=

# ── API para el cotizador web de médicos (/api/web/*; APAGADA por defecto; ver src/web-quote.ts) ──
# on = habilita catalog y quote. Solo servidor a servidor; los usuarios y el límite de fotos viven en el proyecto web.
PLUSMEDIK_WEB_API=
# Token Bearer EXCLUSIVO web -> agente (>= 32 caracteres; distinto de cualquier otra credencial). Es el mismo valor que tendrá el backend del cotizador.
PLUSMEDIK_WEB_API_TOKEN=

# ── Memoria conversacional corta (APAGADA por defecto; ver src/conversation-memory.ts y la migración 17) ──
# on = (solo con PLUSMEDIK_LLM_CONVERSATION activa) se guardan los mensajes de TEXTO de los pacientes y las respuestas del agente confirmadas como enviadas, por contacto y línea de WhatsApp, y antes de
# consultar al modelo se le dan los últimos 5 del mismo contacto como contexto. Vale para todos los pacientes que atienda el agente (el alcance de la prueba lo sigue dando ALLOWED_PHONES). Texto saneado y CIFRADO
# en reposo, sin teléfono, con vencimiento; no se guarda lo que parece de salud, los mensajes automáticos ni los pedidos de cotización con estudios. Exige la 17ª migración (sin ella la memoria falla en silencio y el
# modelo solo ve el mensaje actual) y la autorización de privacidad del laboratorio. NO activar en producción sin autorización.
PLUSMEDIK_CONVERSATION_MEMORY=
# Clave DEDICADA (>= 32 caracteres) para cifrar el texto en reposo. No reutilices WEBHOOK_SECRET, PLUSMEDIK_CONTACT_HMAC_KEY ni PLUSMEDIK_OUTBOX_KEY. Si cambia, lo guardado deja de poder leerse (vence solo).
PLUSMEDIK_MEMORY_KEY=
# Opcionales (en blanco = valores por defecto): días de retención (1-30; 7) y cuántos mensajes se dan al modelo (1-5; 5).
PLUSMEDIK_MEMORY_RETENTION_DAYS=
PLUSMEDIK_MEMORY_LIMIT=

# ── Cotizaciones inteligentes por texto (APAGADO por defecto; ver src/study-interpreter.ts) ──
# on = (solo con PLUSMEDIK_QUOTE_SESSIONS activa) un modelo con herramientas sobre el catálogo (lab_tests y sus alias) entiende errores de ortografía, abreviaturas y pedidos en lenguaje natural cuando el
# resolvedor exacto no basta. El backend valida TODO: solo cuentan estudios que el modelo obtuvo de una búsqueda en el catálogo y siguen activos; "el catálogo no tiene X" solo se informa si el backend también
# lo comprueba; los precios los calcula siempre el backend al cotizar. Si falta un estudio se dice cuál y se cotiza el resto. La preparación y los requisitos solo se agregan si hay datos aprobados (flags
# PLUSMEDIK_QUOTE_PREPARATIONS / PLUSMEDIK_QUOTE_STUDY_DETAILS), como siempre. Al proveedor sale el texto del paciente saneado; los mensajes de salud no se envían. NO activar en producción sin autorización.
PLUSMEDIK_SMART_QUOTES=
# Modelo con llamadas a herramientas y salida JSON estricta. OBLIGATORIO si se activa; no hay valor por defecto (decisión del dueño; p. ej. gpt-4.1-mini).
OPENAI_QUOTE_MODEL=
# Opcionales: razonamiento (low | medium | high | xhigh | max, solo para modelos que lo admiten) y tiempo total por mensaje en ms (2000-60000; 15000).
OPENAI_QUOTE_REASONING=
PLUSMEDIK_SMART_QUOTES_TIMEOUT_MS=

# ── Tope diario de respuestas del agente (APAGADO por defecto; ver src/daily-reply-cap.ts y la migración 18) ──
# on = (solo con PLUSMEDIK_TURNS=on) el agente envía como máximo 5 respuestas por contacto en una ventana móvil de 24 horas (texto, cotizaciones y fotos); al llegar al tope deja de responder a ese contacto
# hasta que sus respuestas más antiguas salgan de la ventana. Los mensajes de las recepcionistas (CRM o WhatsApp Business) no se cuentan ni se limitan. Exige la 18ª migración aplicada ANTES (sin ella no se
# envía nada: falla cerrado). NO activar en producción sin autorización.
PLUSMEDIK_DAILY_REPLY_CAP=
# Opcionales (en blanco = valores por defecto): máximo de respuestas (1-1000; 5) y horas de la ventana (1-168; 24).
PLUSMEDIK_DAILY_REPLY_CAP_MAX=
PLUSMEDIK_DAILY_REPLY_CAP_HOURS=
