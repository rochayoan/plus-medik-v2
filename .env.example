# Nunca commitear claves reales.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Primer mes: máxima calidad. Se pueden cambiar sin tocar código.
GEMINI_READER_MODEL=gemini-4-argon
OPENAI_READER_MODEL=gpt-6.1-sol
OPENAI_JUDGE_MODEL=gpt-6-astra

# Razonamiento inicial. Ajustar después del benchmark, no por intuición.
