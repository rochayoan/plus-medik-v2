# Nunca commitear claves reales. Copia este archivo a .env y completa solo lo que necesites.

# ── Claves (sin valores aquí) ────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
# Si OPENROUTER_API_KEY está definida, Gemini se llama vía OpenRouter en vez de Google AI Studio.
OPENROUTER_API_KEY=
# Catálogo de laboratorio (Supabase). El flujo de análisis solo LEE; las escrituras requieren scripts con --apply explícito.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Modelos (configurables sin tocar código) ─────────────────────────────────
GEMINI_READER_MODEL=gemini-4-argon
OPENAI_READER_MODEL=gpt-6.1-sol
OPENAI_JUDGE_MODEL=gpt-6-astra
OPENROUTER_GEMINI_MODEL=google/gemini-3.8-flash
# Resolvedor de catálogo y señal de documento (GPT sobre el catálogo completo)
OPENAI_CATALOG_MODEL=gpt-6.1-sol

# ── Razonamiento (ajustar después del benchmark, no por intuición) ───────────
GEMINI_THINKING_LEVEL=medium
OPENROUTER_GEMINI_REASONING=medium
OPENAI_READER_REASONING=high
OPENAI_JUDGE_REASONING=high
OPENAI_CATALOG_REASONING=medium
OPENAI_DOCUMENT_REASONING=medium

# ── Banderas semánticas: APAGADAS por defecto ────────────────────────────────
# Solo el valor exacto "on" las enciende; cualquier otro valor o su ausencia las deja apagadas.
# PRIMARY: GPT resuelve TODOS los estudios contra el catálogo completo (con contraste frente al matcher exacto).
CATALOG_SEMANTIC_PRIMARY=off
# AUTO: los MATCH semánticos verificados pueden entrar a una cotización AUTO_SAFE. Solo tiene efecto con PRIMARY=on.
# No activar para usuarios reales sin autorización expresa.
CATALOG_SEMANTIC_AUTO=off
# HANDWRITTEN: evalúa EN SOMBRA si un pedido manuscrito legible podría ser AUTO (documento verificado completo, dos lecturas idénticas sin juez,
# certeza alta, variantes explícitas y matching semántico verificado). Solo existe el valor "shadow": informa un resultado simulado
# (`handwrittenShadow`) y NUNCA cambia la decisión real ni genera cotización. Requiere PRIMARY=on. Cualquier otro valor la deja apagada.
CATALOG_HANDWRITTEN_AUTO=off

# ── Cache local de respuestas de IA (siempre que sea posible, reutilizarlo) ──
# on (por defecto) | off (nunca lee ni escribe cache) | refresh (ignora lo guardado y lo reescribe)
AI_CACHE=on
# AI_CACHE_DIR=.cache

# ── Control de gastos de las pruebas con modelos reales ──────────────────────
# Tarifas (US$ por millón de tokens) con las que scripts/spend.ts estima el costo de OpenAI.
OPENAI_CATALOG_PRICE_INPUT_PER_MTOK=2
OPENAI_CATALOG_PRICE_OUTPUT_PER_MTOK=10
# Los scripts de validación (shadow-match, benchmark-catalog, semantic-primary-check, semantic-auto-check, context-check) BLOQUEAN toda
# llamada real si no se autoriza un máximo en USD por corrida. NO lo dejes definido de forma permanente: pásalo en el comando.
# PLUSMEDIK_AUTHORIZE_PAID_CALLS=0.15
# Referencia independiente usada solo por scripts/semantic-auto-check.ts
# OPENAI_REFERENCE_MODEL=gpt-6.1-sol
# OPENAI_REFERENCE_REASONING=high
