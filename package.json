{
  "name": "plus-medik-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Core multimodal de lectura segura de solicitudes de laboratorio para PlusMedik.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "tsx scripts/benchmark.ts",
    "read-image": "tsx scripts/read-image.ts",
    "benchmark-catalog": "tsx scripts/benchmark-catalog-semantic.ts",
    "shadow-match": "tsx scripts/shadow-match.ts",
    "alias-coverage": "tsx scripts/alias-coverage.ts",
    "alias-batch1": "tsx scripts/prepare-alias-batch1.ts",
    "audit-catalog": "tsx scripts/audit-catalog-aliases.ts",
    "catalog-aliases": "tsx scripts/apply-catalog-aliases.ts",
    "analyze-image": "tsx scripts/analyze-image.ts",
    "catalog-match": "tsx scripts/catalog-match.ts",
    "inspect-catalog": "tsx scripts/inspect-catalog.ts",
    "judge": "tsx scripts/judge.ts",
    "consensus": "tsx scripts/consensus.ts",
    "read-image:openai": "tsx scripts/read-image.ts --openai private-data/receta.jpeg",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@kapso/whatsapp-cloud-api": "^0.2.3",
    "@vercel/functions": "^3.10.1",
    "openai": "^6.0.0",
    "zod": "^4.0.0",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
