# Copia a web/.env.local para desarrollo. En Vercel: Project Settings → Environment Variables.
# Nunca commitear claves reales.

# ── Supabase de PlusMedik (el mismo proyecto que tiene lab_tests) ────────────
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (o anon legacy): segura en el navegador, la RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: catálogo, fotos y panel de administración. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Lectura de fotos (mismas variables que el core, ver ../.env.example) ─────
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# real (por defecto) | mock: resultado simulado sin llamar a modelos (pruebas de carga en preview; prohibido en producción)
ANALYZER_MODE=real
PHOTO_DAILY_LIMIT=40
PHOTO_ANALYSIS_TIMEOUT_MS=240000
# Días que se guardan las fotos de órdenes (datos clínicos); el cron diario borra las más viejas.
PHOTO_RETENTION_DAYS=30
# Vercel lo envía al cron (/api/cron/cleanup). Generar con: openssl rand -hex 32
CRON_SECRET=

# ── Marca (PDF y texto de WhatsApp; los vacíos no se muestran) ────────────────
BRAND_NAME=PlusMedik
BRAND_ADDRESS=
BRAND_PHONE=
BRAND_HOURS=
BRAND_FOOTER_NOTE=
QUOTE_VALIDITY_DAYS=30

# Cache del catálogo en memoria por instancia (ms)
CATALOG_CACHE_TTL_MS=300000
